    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
